<Window x:Class="Quotio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Quotio.App.ViewModels.Screens"
        xmlns:views="clr-namespace:Quotio.App.Views.Screens"
        mc:Ignorable="d"
        Title="Quotio for Windows" Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:QuotaViewModel}">
            <views:QuotaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProvidersViewModel}">
            <views:ProvidersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AgentsViewModel}">
            <views:AgentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApiKeysViewModel}">
            <views:ApiKeysView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#673AB7" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Padding="20" Background="#5E35B1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="24" Foreground="White" Margin="0,0,10,0"/>
                        <TextBlock Text="Quotio" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button Content="📊 Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" 
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"/>
                    <Button Content="📈 Quota" Command="{Binding NavigateCommand}" CommandParameter="Quota"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"/>
                    <Button Content="☁️ Providers" Command="{Binding NavigateCommand}" CommandParameter="Providers"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"/>
                    <Button Content="🤖 Agents" Command="{Binding NavigateCommand}" CommandParameter="Agents"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"/>
                    <Button Content="🔑 API Keys" Command="{Binding NavigateCommand}" CommandParameter="ApiKeys"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"/>
                    <Button Content="📝 Logs" Command="{Binding NavigateCommand}" CommandParameter="Logs"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"/>
                    <Button Content="⚙️ Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"/>
                    <Button Content="ℹ️ About" Command="{Binding NavigateCommand}" CommandParameter="About"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" 
                            HorizontalContentAlignment="Left" Padding="20,12" FontSize="14"/>
                </StackPanel>

                <!-- Proxy Status -->
                <Border Grid.Row="2" Padding="15" Background="#5E35B1">
                    <StackPanel>
                        <TextBlock Text="{Binding ProxyStatusText}" Foreground="White" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                        <Button Command="{Binding ToggleProxyCommand}" Padding="10,8" Background="#7E57C2" Foreground="White" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏯" Margin="0,0,8,0"/>
                                <TextBlock Text="Toggle Proxy"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Padding="25">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>
